{
  "name": "yeshi-music-mobile",
  "version": "0.1.0",
  "description": "叶诗音乐 - 手机端（Android/iOS）本地音乐播放器，复用桌面端纯 JS 解密核心",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "selfcheck": "node src/tools/selfcheck.js",
    "integration-test": "node --experimental-loader ./src/tools/mock-loader.mjs src/tools/integration-test.js",
    "web-smoke": "node src/tools/web-smoke.js",
    "test": "npm run selfcheck && npm run integration-test && npm run web-smoke",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/preferences": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "vite": "^5.4.0"
  }
}
